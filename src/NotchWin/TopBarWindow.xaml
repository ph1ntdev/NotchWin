<Window x:Class="NotchWin.TopBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NotchWin Bar"
        Width="1200" Height="32"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#4C1C1C1C"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">

  <!-- Верхняя панель как в macOS: полупрозрачная с размытием, слева активное приложение,
       справа рабочие кнопки статуса. Окно зарегистрировано как AppBar,
       поэтому развёрнутые окна начинаются под ним. Чёрная челка рисуется поверх в отдельном окне. -->
  <Window.Resources>
    <Style x:Key="Item" TargetType="TextBlock">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Icon" TargetType="TextBlock" BasedOn="{StaticResource Item}">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style x:Key="BarButton" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Margin" Value="1,0"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="#01FFFFFF" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#40FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid x:Name="BarRoot" Margin="8,0" Background="#01000000">
    <Grid.ContextMenu>
      <ContextMenu>
        <MenuItem Header="Настройки" Click="OnSettings"/>
        <MenuItem Header="Выход" Click="OnExit"/>
      </ContextMenu>
    </Grid.ContextMenu>

    <TextBlock x:Name="AppNameText" Style="{StaticResource Item}" FontWeight="SemiBold" Margin="8,0"
               HorizontalAlignment="Left" MaxWidth="360" TextTrimming="CharacterEllipsis"/>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <!-- Значки программ из трея Windows. Спрятанные в Windows значки — под стрелкой -->
      <Button x:Name="TrayMoreButton" Style="{StaticResource BarButton}" Click="OnTrayMore" Padding="6,0" Visibility="Collapsed"
              ToolTip="Скрытые значки">
        <TextBlock x:Name="TrayMoreIcon" Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="11"/>
      </Button>
      <StackPanel x:Name="TrayPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0"/>
      <!-- Поиск как Spotlight: клик или Alt+Пробел -->
      <Button x:Name="SearchButton" Style="{StaticResource BarButton}" Click="OnSearchClick">
        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13"/>
      </Button>
      <!-- Погода: значок и температура, клик открывает прогноз -->
      <Button x:Name="WeatherButton" Style="{StaticResource BarButton}" Click="OnWeatherClick">
        <Button.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Обновить погоду" Click="OnWeatherRefresh"/>
            <MenuItem Header="Выбрать город…" Click="OnWeatherSettings"/>
          </ContextMenu>
        </Button.ContextMenu>
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="WeatherIcon" Style="{StaticResource Item}" FontFamily="Segoe UI Symbol" FontSize="13" Margin="0,0,5,0"/>
          <TextBlock x:Name="WeatherText" Style="{StaticResource Item}" FontSize="12.5"/>
        </StackPanel>
      </Button>
      <!-- Корзина: клик открывает её, а если навести файл, появляется большое окно для сброса -->
      <Button x:Name="BinButton" Style="{StaticResource BarButton}" Click="OnBinClick" AllowDrop="True"
              DragEnter="OnBinDragEnter" DragOver="OnBinDragOver" Drop="OnBinDrop" ContextMenuOpening="OnBinMenuOpening">
        <Button.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Открыть корзину" Click="OnBinClick"/>
            <MenuItem x:Name="BinEmptyItem" Header="Очистить корзину" Click="OnBinEmpty" StaysOpenOnClick="True"/>
          </ContextMenu>
        </Button.ContextMenu>
        <TextBlock x:Name="BinIcon" Style="{StaticResource Icon}" Text="&#xE74D;"/>
      </Button>
      <Button x:Name="LayoutButton" Style="{StaticResource BarButton}" Click="OnLayoutClick">
        <Button.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Языки и раскладки…" Click="OnLanguageSettings"/>
          </ContextMenu>
        </Button.ContextMenu>
        <TextBlock x:Name="LayoutText" Style="{StaticResource Item}" FontSize="12" FontWeight="SemiBold"/>
      </Button>
      <Button x:Name="VolumeButton" Style="{StaticResource BarButton}" Click="OnVolumeClick" MouseWheel="OnVolumeWheel"
              MouseRightButtonUp="OnVolumeRightClick">
        <TextBlock x:Name="VolumeIcon" Style="{StaticResource Icon}" Text="&#xE767;"/>
      </Button>
      <Button x:Name="BatteryButton" Style="{StaticResource BarButton}" Click="OnBatteryClick" Visibility="Collapsed">
        <Button.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Параметры питания…" Click="OnBatteryClick"/>
          </ContextMenu>
        </Button.ContextMenu>
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="BatteryText" Style="{StaticResource Item}" FontSize="12" Margin="0,0,4,0"/>
          <TextBlock x:Name="BatteryIcon" Style="{StaticResource Icon}" FontSize="16"/>
        </StackPanel>
      </Button>
      <Button x:Name="ClockButton" Style="{StaticResource BarButton}" Click="OnClockClick">
        <Button.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Дата и время…" Click="OnTimeSettings"/>
          </ContextMenu>
        </Button.ContextMenu>
        <TextBlock x:Name="ClockText" Style="{StaticResource Item}"/>
      </Button>
    </StackPanel>

    <Popup x:Name="TrayPopup" PlacementTarget="{Binding ElementName=TrayMoreButton}" Placement="Bottom"
           VerticalOffset="6" HorizontalOffset="-60" AllowsTransparency="True">
      <Border x:Name="TrayCard" Style="{StaticResource PopupCard}" Padding="8">
        <WrapPanel x:Name="TrayOverflow" MaxWidth="168"/>
      </Border>
    </Popup>

    <!-- Микшер громкости в стиле EarTrumpet: выпадает сверху из значка звука -->
    <Popup x:Name="VolumePopup" PlacementTarget="{Binding ElementName=VolumeButton}" Placement="Bottom"
           VerticalOffset="6" HorizontalOffset="-150" AllowsTransparency="True">
      <Border x:Name="VolumeCard" Style="{StaticResource PopupCard}" Width="330">
        <StackPanel>
          <TextBlock Text="Устройство вывода" Foreground="#99FFFFFF" FontSize="11.5" Margin="2,0,0,4"/>
          <StackPanel x:Name="DevicesPanel"/>

          <Border Height="1" Background="#22FFFFFF" Margin="0,10"/>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="32"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource BarButton}" Click="OnMuteClick" Padding="4,0" ToolTip="Выключить звук">
              <TextBlock x:Name="PopupMuteIcon" Style="{StaticResource Icon}" Text="&#xE767;" FontSize="16"/>
            </Button>
            <StackPanel Grid.Column="1" Margin="8,0">
              <TextBlock Text="Общая громкость" FontSize="12" FontWeight="SemiBold"/>
              <Slider x:Name="VolumeSlider" Style="{StaticResource FlatSlider}" ValueChanged="OnVolumeSlider"/>
            </StackPanel>
            <TextBlock x:Name="VolumePercent" Grid.Column="2" Style="{StaticResource Item}" FontSize="12"
                       TextAlignment="Right"/>
          </Grid>

          <Border Height="1" Background="#22FFFFFF" Margin="0,10"/>

          <TextBlock x:Name="AppsHeader" Text="Приложения" Foreground="#99FFFFFF" FontSize="11.5" Margin="2,0,0,4"/>
          <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="AppsPanel"/>
          </ScrollViewer>
        </StackPanel>
      </Border>
    </Popup>

    <!-- Свой календарь: выпадает сверху из часов -->
    <Popup x:Name="CalendarPopup" PlacementTarget="{Binding ElementName=ClockButton}" Placement="Bottom"
           VerticalOffset="6" HorizontalOffset="-140" AllowsTransparency="True">
      <Border x:Name="CalendarCard" Style="{StaticResource PopupCard}" Width="300" Padding="16,14">
        <StackPanel>
          <TextBlock x:Name="CalendarToday" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock x:Name="CalendarTodaySub" Foreground="#99FFFFFF" FontSize="12.5" Margin="0,2,0,12"/>

          <Grid Margin="0,0,0,6">
            <TextBlock x:Name="CalendarMonth" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Style="{StaticResource BarButton}" Click="OnCalendarPrev" Padding="8,0" ToolTip="Предыдущий месяц">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE76B;" FontSize="11"/>
              </Button>
              <Button Style="{StaticResource BarButton}" Click="OnCalendarToday" Padding="8,0" ToolTip="Сегодня">
                <Ellipse Width="6" Height="6" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Button>
              <Button Style="{StaticResource BarButton}" Click="OnCalendarNext" Padding="8,0" ToolTip="Следующий месяц">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="11"/>
              </Button>
            </StackPanel>
          </Grid>

          <UniformGrid x:Name="WeekdayRow" Columns="7" Margin="0,0,0,2"/>
          <!-- Сетка дней обрезается по краям, чтобы при листании месяц уезжал вбок -->
          <Border ClipToBounds="True">
            <UniformGrid x:Name="DaysGrid" Columns="7" Rows="6">
              <UniformGrid.RenderTransform>
                <TranslateTransform x:Name="DaysShift"/>
              </UniformGrid.RenderTransform>
            </UniformGrid>
          </Border>
        </StackPanel>
      </Border>
    </Popup>

    <!-- Погода: выпадает сверху из значка -->
    <Popup x:Name="WeatherPopup" PlacementTarget="{Binding ElementName=WeatherButton}" Placement="Bottom"
           VerticalOffset="6" HorizontalOffset="-120">
      <Border x:Name="WeatherCard" Style="{StaticResource PopupCard}" Width="310" Padding="16,14">
        <StackPanel>
          <Grid>
            <StackPanel>
              <TextBlock x:Name="WeatherCity" Foreground="#B3FFFFFF" FontSize="13" FontWeight="SemiBold"/>
              <TextBlock x:Name="WeatherBig" Foreground="White" FontSize="40" FontWeight="Light" Margin="0,-2,0,0"/>
            </StackPanel>
            <TextBlock x:Name="WeatherBigIcon" FontFamily="Segoe UI Symbol" Foreground="White" FontSize="40"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,6,4,0"/>
          </Grid>
          <TextBlock x:Name="WeatherCondition" Foreground="White" FontSize="13.5" FontWeight="SemiBold"/>
          <TextBlock x:Name="WeatherDetails" Foreground="#99FFFFFF" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>

          <Border Height="1" Background="#22FFFFFF" Margin="0,12"/>
          <UniformGrid x:Name="WeatherHours" Columns="6" Height="62"/>
          <Border Height="1" Background="#22FFFFFF" Margin="0,10"/>
          <StackPanel x:Name="WeatherDays" Height="112"/>

          <Grid Margin="0,8,0,0">
            <TextBlock x:Name="WeatherSource" Foreground="#66FFFFFF" FontSize="11" VerticalAlignment="Center"/>
            <Button Style="{StaticResource BarButton}" Click="OnWeatherRefresh" HorizontalAlignment="Right" Height="22" Padding="8,0">
              <TextBlock Text="Обновить" Style="{StaticResource Item}" FontSize="11.5"/>
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </Popup>

    <!-- Большая корзина: появляется прямо над значком, когда на него тащат файл.
         Значок «выезжает» в центр окна, растёт и загорается красным. -->
    <Popup x:Name="BinPopup" PlacementTarget="{Binding ElementName=BinButton}" Placement="Relative"
           VerticalOffset="-4">
      <Border x:Name="BinCard" Style="{StaticResource PopupCard}" Width="220" Padding="16,8,16,16" AllowDrop="True"
              DragEnter="OnBinCardDragOver" DragOver="OnBinCardDragOver" DragLeave="OnBinCardDragLeave" Drop="OnBinDrop">
        <StackPanel>
          <Border x:Name="BinCircle" Width="96" Height="96" CornerRadius="48" Background="#1FFFFFFF"
                  RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
              <TransformGroup>
                <ScaleTransform x:Name="BinScale"/>
                <TranslateTransform x:Name="BinShift"/>
              </TransformGroup>
            </Border.RenderTransform>
            <TextBlock x:Name="BinBigIcon" Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="44"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock x:Name="BinTitle" Text="Отпустите, чтобы удалить" Foreground="White" FontSize="14" FontWeight="SemiBold"
                     HorizontalAlignment="Center" Margin="0,12,0,2"/>
          <TextBlock x:Name="BinSub" Text="Файлы можно будет восстановить" Foreground="#99FFFFFF"
                     FontSize="11.5" TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</Window>
